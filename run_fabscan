#!/bin/bash

# Navigate to the project directory
cd ~/projects/FabScan || exit 1

# Activate the virtual environment
source venv/bin/activate

# Set environment variables and run the app with resource constraints
OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
taskset -c 3,4 nice -n 15 ionice -c3 python3 fabscan.py
